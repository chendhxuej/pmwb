-  while (true) {
-    const res = await getRequirements({ priority: '集团需求', page, page_size: pageSize })
-    const items = res.items || []
-    all.push(...items.map((r) => ({ ...r, ext: r.ext || {} })))
-    const total = res.total || 0
-    if (all.length >= total || items.length < pageSize) break
-    page += 1
-  }
-  return all
-}
