-    if (!valid) return
-    const payload = {
-      title: editForm.title,
-      category: editForm.category || undefined,
-      description: editForm.description || undefined,
-      sql_text: editForm.sql_text,
-      output_fields: editForm.output_fields.filter((f) => f.name && f.name.trim()),
-    }
-    saving.value = true
