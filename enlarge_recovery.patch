-    if (!valid) return
-    const payload = {
-      item_id: generateItemId(),
-      title: createForm.title,
-      category: createForm.category,
-      obsidian_path: createForm.obsidian_path || buildObsidianPath(createForm),
-      tags: createTags.value.join(','),
