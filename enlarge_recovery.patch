-
-const linkDialogVisible = ref(false)
-const linkOptions = ref([])
-const linkTarget = ref(null)
-const linkLoading = ref(false)
-
-const filteredNotes = computed(() => {
-  const kw = noteSearch.value.trim().toLowerCase()
