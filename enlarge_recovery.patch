-  return allIssues.value.filter((i) => {
-    if (selectedCategory.value !== 'all' && i.category !== selectedCategory.value) return false
-    if (kw && !(`${i.issue_no} ${i.title} ${i.handler || ''}`.toLowerCase().includes(kw))) return false
-    return true
-  })
-})
