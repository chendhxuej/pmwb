-  try {
-    await operationApi.updateIssue(row.id, { status })
-    ElMessage.success('状态已更新')
-    loadStats()
-    loadIssues()
-  } catch (e) {
-    ElMessage.error('状态更新失败：' + (e?.response?.data?.message || e.message || '未知错误'))
-  } finally {
-    delete statusLoadingMap.value[row.id]
-  }
-}
