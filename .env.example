# 复制本文件到 backend/.env 后填写真实值
# 注意：DB_PASSWORD 与 SECRET_KEY 无默认值，缺失会启动报错

# 数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=<必填：数据库密码>
DB_NAME=yxtyg_db
DB_CHARSET=utf8mb4

# 构造后的数据库URL（可选，留空则由上面各项自动构造）
DATABASE_URL=

# 统一邮件中心（外部服务，端口 3210）
EMAIL_CENTER_URL=http://localhost:3210
# 可选，若邮件中心开启了鉴权则填写
EMAIL_CENTER_API_KEY=

# 人员中台 Master Service（services/master，端口 8001）
# 组织/人员/联系方式的唯一数据源，禁止各模块自建人员表
MASTER_SERVICE_URL=http://localhost:8001

# Obsidian 知识库路径
OBSIDIAN_VAULT_PATH=D:\\项目\\知识图谱

# 应用配置
APP_NAME=产品经理个人工作台
APP_VERSION=0.1.0
# 生产/日常使用保持 false
DEBUG=false
SECRET_KEY=<必填：随机长字符串，用于会话签名>

# 后端服务
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# 前端服务
FRONTEND_PORT=5173
