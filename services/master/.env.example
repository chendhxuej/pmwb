# 复制到 services/master/.env 后填写真实值
# 人员中台（Master Service）独立微服务使用的数据库连接配置

MASTER_DB_HOST=127.0.0.1
MASTER_DB_PORT=3306
MASTER_DB_USER=root
MASTER_DB_PASSWORD=<必填：数据库密码>
MASTER_DB_NAME=pmwb_master
MASTER_DB_CHARSET=utf8mb4

# 本微服务监听端口（前端通过 MASTER_SERVICE_URL 访问，默认 http://localhost:8001）
MASTER_PORT=8001
